{
    "manifest_version": 3,
    "name": "Nik's crappy web clipper",
    "version": "2.3",
    "description": "One-click clipping to a web service of your choice.",
    "host_permissions": [
        "<all_urls>"
    ],
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "contextMenus"
    ],
    "action": {
        "default_title": "Clip Job to Sheet",
        "default_popup": "popup.html"
    },
    "options_page": "popup.html",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}